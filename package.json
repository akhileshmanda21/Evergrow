{
  "name": "riseo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"vite.config.js\" \"eslint.config.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"vite.config.js\" \"eslint.config.js\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
